@page
@model WebAppResit.Pages.ContactModel
@{
    ViewData["Title"] = "Contact Us";
}

<h2>Contact Us</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="Contact.Username" class="control-label"></label>
        <input asp-for="Contact.Username" class="form-control" />
        <span asp-validation-for="Contact.Username" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Contact.Email" class="control-label"></label>
        <input asp-for="Contact.Email" class="form-control" />
        <span asp-validation-for="Contact.Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Contact.Message" class="control-label"></label>
        <textarea asp-for="Contact.Message" class="form-control"></textarea>
        <span asp-validation-for="Contact.Message" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Send" class="btn btn-primary" />
    </div>
</form>
<div id="map"></div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/map.js"></script>
}





