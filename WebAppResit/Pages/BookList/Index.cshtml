@page
@using System.Drawing
@using Microsoft.AspNetCore.Identity
@model WebAppResit.Pages.BookList.IndexModel

@{
    ViewData["Title"] = "Index";

    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@*
<h1>Admin Pages</h1>
<p>These pages require Admin to access</p>*@
<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BookItem[0].ItemName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookItem[0].Item_desc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookItem[0].Author)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookItem[0].Available)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookItem[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BookItem[0].ImageData)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.BookItem) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ItemName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Item_desc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Author)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Available)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            @{
            try
            {
            <td>
                <img src="@string.Format("data:image/jpg:base64,{0}", Convert.ToBase64String(item.ImageData))" alt="@item.ImageDescription"/>
            </td>

            }
            catch
                {
                    <td>
                        <img class="img-thumb" src="/Images/no-image.png" alt="No Image Provided" />
                    </td>
                }
            }
            <td>
                <form method="post" asp-page-handler="Buy">
                    <input type="hidden" name="itemISBN" value="@item.ISBN" />
                    <button type="submit">Add to Basket</button>
                </form>
            </td>
            @if (User.IsInRole("Admin"))
            {
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ISBN">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ISBN">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ISBN">Delete</a>
                </td>
            }

    </tr>
}
    </tbody>
</table>
