<div class="flex-container">
    @foreach (var tblBookItem in Model.BookItems)
    {
        <div>
            <p>@Html.DisplayFor(modelItem => tblBookItem.ItemName)</p>
            <p>@Html.DisplayFor(modelItem => tblBookItem.Author)</p>
            <p>@Html.DisplayFor(modelItem => tblBookItem.Price)</p>
            <p>@Html.DisplayFor(modelItem => tblBookItem.Item_desc)</p>
            <p>@Html.DisplayFor(modelItem => tblBookItem.ImageData)</p>
                
        </div>
    }
    
</div>
<h2>Search</h2>
<form method="post">
    <div>Search <input asp-for="Search" /></div>
    <button type="submit" asp-page-handler="Search">Submit</button>
</form>

